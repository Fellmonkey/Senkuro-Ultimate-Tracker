{
  "manifest_version": 3,
  "name": "Senkuro Ultimate Tracker",
  "version": "1.0",
  "description": "Расширение для отслеживания прогресса чтения манги на senkuro.com / senkuro.me.",
  "permissions": ["storage", "tabs", "cookies"],
  "host_permissions": ["*://senkuro.com/*", "*://senkuro.me/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://senkuro.com/*", "*://senkuro.me/*"],
      "js": ["senkuro-api.js", "content.js"]
    }
  ]
}
